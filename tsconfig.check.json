{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "extensions/compaction.ts",
    "extensions/web-search.ts",
    "extensions/reasoning-translation.ts",
    "src/compact-client.ts",
    "src/config.ts",
    "src/debug.ts",
    "src/details-store.ts",
    "src/extension-runtime.ts",
    "src/native-fallback.ts",
    "src/payload-rewrite.ts",
    "src/provider-headers.ts",
    "src/remote-v2-client.ts",
    "src/request-context-cache.ts",
    "src/runtime.ts",
    "src/serializer.ts",
    "src/supported-environment.ts",
    "src/types.ts",
    "src/web-search/extension.ts",
    "src/web-search/payload.ts",
    "src/web-search/prompt.ts",
    "src/web-search/types.ts",
    "src/reasoning-translation/client.ts",
    "src/reasoning-translation/extension.ts",
    "src/reasoning-translation/persistence.ts",
    "src/reasoning-translation/segmenter.ts",
    "src/reasoning-translation/state.ts",
    "src/reasoning-translation/types.ts"
  ]
}
