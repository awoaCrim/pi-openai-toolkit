{
  "name": "pi-openai-toolkit",
  "version": "0.14.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "OpenAI toolkit for Pi: Codex Remote Context windows, remote compaction v2, hosted Web Search, image gen, auto mode.",
  "author": "awoaCrim and contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awoaCrim/pi-openai-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/awoaCrim/pi-openai-toolkit/issues"
  },
  "homepage": "https://github.com/awoaCrim/pi-openai-toolkit#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
    "compaction",
    "web-search",
    "image-generation",
    "auto-mode",
    "codex",
    "responses"
  ],
  "pi": {
    "extensions": [
      "./extensions/compaction.ts",
      "./extensions/web-search.ts",
      "./extensions/image-generation.ts",
      "./extensions/auto-mode.ts",
      "./extensions/codex-astra.ts"
    ]
  },
  "files": [
    "extensions/compaction.ts",
    "extensions/web-search.ts",
    "extensions/image-generation.ts",
    "extensions/auto-mode.ts",
    "src/compact-client.ts",
    "src/config.ts",
    "src/debug.ts",
    "src/details-store.ts",
    "src/deferred-tool-carryover.ts",
    "src/extension-runtime.ts",
    "src/context-management/types.ts",
    "src/context-management/messages.ts",
    "src/context-management/window-budget.ts",
    "src/context-management/window-request.ts",
    "src/context-management/window-manager.ts",
    "src/context-management/codex-provider.ts",
    "src/context-management/history-notes.ts",
    "src/context-management/tools.ts",
    "src/context-management/namespace-tools.ts",
    "src/context-management/tool-contract.ts",
    "src/image-generation/artifacts.ts",
    "src/image-generation/client.ts",
    "src/image-generation/eligibility.ts",
    "src/image-generation/extension.ts",
    "src/image-generation/protocol.ts",
    "src/image-generation/references.ts",
    "src/image-generation/render.ts",
    "src/image-generation/service.ts",
    "src/image-generation/types.ts",
    "src/auto-mode/extension.ts",
    "src/auto-mode/policy.ts",
    "src/auto-mode/prompt.ts",
    "src/auto-mode/transcript.ts",
    "src/auto-mode/reviewer.ts",
    "src/auto-mode/classifier.ts",
    "src/auto-mode/types.ts",
    "extensions/codex-astra.ts",
    "src/codex-astra/effort-planner.ts",
    "src/codex-astra/extension.ts",
    "src/model-scope.ts",
    "src/native-fallback.ts",
    "src/payload-rewrite.ts",
    "src/provider-headers.ts",
    "src/responses-headers.ts",
    "src/remote-v2-client.ts",
    "src/request-context-cache.ts",
    "src/runtime.ts",
    "src/serializer.ts",
    "src/supported-environment.ts",
    "src/types.ts",
    "src/web-search/extension.ts",
    "src/web-search/payload.ts",
    "src/web-search/prompt.ts",
    "src/web-search/types.ts",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "tsconfig.check.json"
  ],
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && node ./scripts/check-lcov.mjs ./coverage/lcov.info",
    "test:pi": "bun test ./test/pi-smoke.test.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1",
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "24.12.4",
    "bun": "1.2.23",
    "typescript": "5.9.3"
  }
}
