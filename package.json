{
  "name": "pi-openai-toolkit",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "OpenAI-focused Pi toolkit providing remote Responses compaction, native Web Search, and TUI reasoning translation.",
  "author": "awoaCrim and contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awoaCrim/pi-openai-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/awoaCrim/pi-openai-toolkit/issues"
  },
  "homepage": "https://github.com/awoaCrim/pi-openai-toolkit#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
    "compaction",
    "web-search",
    "reasoning-translation",
    "codex",
    "responses"
  ],
  "pi": {
    "extensions": [
      "./extensions/compaction.ts",
      "./extensions/web-search.ts",
      "./extensions/reasoning-translation.ts"
    ]
  },
  "files": [
    "extensions/compaction.ts",
    "extensions/web-search.ts",
    "extensions/reasoning-translation.ts",
    "src/compact-client.ts",
    "src/config.ts",
    "src/debug.ts",
    "src/details-store.ts",
    "src/extension-runtime.ts",
    "src/native-fallback.ts",
    "src/payload-rewrite.ts",
    "src/provider-headers.ts",
    "src/remote-v2-client.ts",
    "src/request-context-cache.ts",
    "src/runtime.ts",
    "src/serializer.ts",
    "src/supported-environment.ts",
    "src/types.ts",
    "src/web-search/extension.ts",
    "src/web-search/payload.ts",
    "src/web-search/prompt.ts",
    "src/web-search/types.ts",
    "src/reasoning-translation/client.ts",
    "src/reasoning-translation/extension.ts",
    "src/reasoning-translation/persistence.ts",
    "src/reasoning-translation/segmenter.ts",
    "src/reasoning-translation/state.ts",
    "src/reasoning-translation/types.ts",
    "README.md",
    "README_zh.md",
    "LICENSE",
    "NOTICE",
    "tsconfig.check.json"
  ],
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && node ./scripts/check-lcov.mjs ./coverage/lcov.info",
    "test:pi": "bun test ./test/pi-smoke.test.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "bun": "1.2.23",
    "typescript": "5.9.3"
  }
}
